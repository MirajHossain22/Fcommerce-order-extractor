# Copy to .env and supply your provider, model, and secret locally.
# Phase 2 supports Gemini. Choose a model supporting structured JSON output.
PROVIDER=gemini
MODEL=gemini-3.8-flash
API_KEY=

# JSON mapping of long random bearer keys to seller IDs; empty disables seller APIs.
# Existing records migrate to seller ID "legacy" by default. Use that ID to access them.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SELLER_API_KEYS={}

# Hosted pilot launcher reads these from process environment (not this file).
# Use an absolute persistent-storage path and your exact public hostname.
# DATABASE_PATH=/data/orders.sqlite3
# ALLOWED_HOSTS=orders.example.com
# HOST=0.0.0.0
# PORT=8000
# FORWARDED_ALLOW_IPS=127.0.0.1
